{
  "name": "dsh-pause-resume",
  "version": "0.8.2",
  "type": "module",
  "description": "One header button stops running turns, goals and jobs, writes a plan to disk, and restores that work after a restart or crash; the button shape is the only status.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "pause",
    "resume",
    "snapshot",
    "crash-recovery"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/dsh-pause-resume.git"
  },
  "homepage": "https://github.com/regrevia/dsh-pause-resume#readme",
  "bugs": {
    "url": "https://github.com/regrevia/dsh-pause-resume/issues"
  },
  "engines": {
    "node": ">=22.15.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "audit": "eslint index.js client.js lib/*.js acceptance/*.mjs",
    "smoke:host": "node acceptance/host-smoke.mjs",
    "smoke:live": "node acceptance/host-live.mjs",
    "smoke:maintenance": "node acceptance/host-maintenance.mjs"
  },
  "devDependencies": {
    "eslint": "9.39.0"
  }
}
